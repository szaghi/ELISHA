[project]
name       = ELISHA
version    = VERSION
summary    = Elliptic Laplacian Inversion: Spectral and Hierarchical Algorithms: FFT and AMR multigrid Poisson solvers for HPC
repository = https://github.com/szaghi/ELISHA
website    = https://szaghi.github.io/ELISHA
email      = stefano.zaghi@gmail.com
year       = 2026
authors    = Stefano Zaghi

# fobis scaffold: the CI runs in the fortran-toolchains images; the matrix builds tests-$TOOLCHAIN_FAMILY
# (gnu, nvf, intel) on every Linux vendor and runs scripts/run_tests.sh
[scaffold]
toolchain = linux-gnu
matrix    = linux-gnu linux-nvhpc linux-oneapi
fpm       = true

# fobis ecosystem check: what proves this project still works against a dependency's working copy
[ecosystem]
check = fobis fetch
        fobis build --mode tests-gnu
        bash scripts/run_tests.sh

# PENF is compiled from its sources by the compiler of the mode (no per-compiler PENF build to keep in step)
[dependencies]
deps_dir = src/third_party
PENF     = https://github.com/szaghi/PENF :: branch=master
# test-only: the D1 rows cross-checked against GIDEON's (src/tests/elisha_test_gideon_d1); the library never uses it
GIDEON   = https://github.com/szaghi/GIDEON :: branch=main

[modes]
# the first mode is the default (fobis build, scripts/install.sh): the MPI library any gfortran + Open MPI builds
modes = static-gnu shared-gnu
        static-nvf shared-nvf
        static-intel shared-intel
        static-gnu-serial static-nvf-serial
        tests-gnu tests-gnu-debug tests-gnu-coverage tests-gnu-serial
        tests-nvf tests-nvf-debug tests-nvf-oac tests-nvf-serial
        tests-intel tests-intel-debug
        bench-gnu bench-nvf

[common-variables]
$EXDIRS = PENF/src/tests/ PENF/src/third_party/ PENF/scripts/ PENF/docs/
          GIDEON/src/tests/ GIDEON/src/bench/ GIDEON/src/examples/ GIDEON/src/third_party/ GIDEON/scripts/ GIDEON/docs/
          GIDEON/notes/
$STD_GNU = -std=f2018
$STD_INT = -standard-semantics -std18
# NVIDIA compute capability of the OpenACC modes; override with --varset (e.g. --varset cc90)
$GPU_CC = cc89

# medooza (CNR-IAC): A30 (cc80); its node drivers cannot run CUDA 13, so CUDA 12.9 (as SETH, SELAH)
[varset:iac]
$GPU_CC = cc80,cuda12.9

[varset:cc80]
$GPU_CC = cc80

[varset:cc89]
$GPU_CC = cc89

[varset:cc90]
$GPU_CC = cc90

# ── library modes (MPI; FFTW is linked by the client) ────────────────────────
[static-gnu]
help      = Static library, gfortran + MPI, optimised
template  = template-lib-static template-gnu template-mpi template-release
build_dir = lib/gnu/static/

[shared-gnu]
help      = Shared library, gfortran + MPI, optimised
template  = template-lib-shared template-gnu template-mpi template-release
cflags    = -c -fPIC $STD_GNU
build_dir = lib/gnu/shared/

[static-nvf]
help      = Static library, nvfortran + MPI (HPC-X), optimised
template  = template-lib-static template-nvf template-mpi template-release
build_dir = lib/nvf/static/

[shared-nvf]
help      = Shared library, nvfortran + MPI (HPC-X), optimised
template  = template-lib-shared template-nvf template-mpi template-release
cflags    = -c -fPIC
build_dir = lib/nvf/shared/

[static-intel]
help      = Static library, ifx + MPI, optimised
template  = template-lib-static template-intel-release template-intel template-mpi
build_dir = lib/intel/static/

[shared-intel]
help      = Shared library, ifx + MPI, optimised
template  = template-lib-shared template-intel template-mpi
cflags    = -c -fPIC -O3 $STD_INT
build_dir = lib/intel/shared/

# ── serial library modes: no MPI (-DELISHA_NO_MPI), one rank ─────────────────
[static-gnu-serial]
help      = Static library, gfortran, serial (no MPI), optimised
template  = template-lib-static template-serial template-gnu template-release
build_dir = lib/gnu/static-serial/
output    = libelisha_serial.a

[static-nvf-serial]
help      = Static library, nvfortran, serial (no MPI), optimised
template  = template-lib-static template-serial template-nvf template-release
build_dir = lib/nvf/static-serial/
output    = libelisha_serial.a

# ── test modes: every program of src/tests into exe/, run by scripts/run_tests.sh ──
[tests-gnu]
help      = Tests, gfortran + MPI, optimised (fortran-toolchains matrix: family gnu)
template  = template-tests template-gnu template-mpi template-release

[tests-gnu-debug]
help      = Tests, gfortran + MPI, all checks on
template  = template-tests template-gnu template-mpi template-debug

[tests-gnu-coverage]
help      = Tests, gfortran + MPI, coverage instrumentation (rule makecoverage)
template  = template-tests template-gnu template-mpi
build_profile = coverage

[tests-gnu-serial]
help      = Tests, gfortran, serial (no MPI), optimised
template  = template-tests template-serial template-gnu template-release

[tests-nvf]
help      = Tests, nvfortran + MPI (HPC-X), optimised, CPU (fortran-toolchains matrix: family nvf)
template  = template-tests template-nvf template-mpi template-release

[tests-nvf-debug]
help      = Tests, nvfortran + MPI (HPC-X), all checks on
template  = template-tests template-nvf template-mpi template-debug

[tests-nvf-oac]
help      = Tests, nvfortran + MPI (HPC-X), OpenACC on the GPU of compute capability $GPU_CC
template  = template-tests template-nvf template-mpi template-release
cflags    = -c -acc -gpu=$GPU_CC -Minfo=accel
lflags    = -acc -gpu=$GPU_CC

[tests-nvf-serial]
help      = Tests, nvfortran, serial (no MPI), optimised, CPU
template  = template-tests template-serial template-nvf template-release

[tests-intel]
help      = Tests, ifx + MPI, optimised (fortran-toolchains matrix: family intel)
template  = template-tests template-intel-release template-intel template-mpi

[tests-intel-debug]
help      = Tests, ifx + MPI, all checks on
template  = template-tests template-intel template-mpi template-debug

# ── benchmark modes: src/bench/elisha_bench_spectral_mpi.F90 into exe-bench/ (not a test: scripts/run_tests.sh runs
# exe/ only, fpm does not build src/bench); the ADAM oracle it times against lives in src/tests/ ──
[bench-gnu]
help      = Benchmark of the spectral solver against ADAM's, gfortran + MPI, optimised
template  = template-bench template-gnu template-mpi template-release

[bench-nvf]
help      = Benchmark of the spectral solver against ADAM's, nvfortran + MPI (HPC-X), optimised, CPU
template  = template-bench template-nvf template-mpi template-release

# ── templates: left wins when a mode lists several, so the role template (lib, tests) comes first ──
[template-base]
preproc         = -D_FFTW
src             = src/lib/
exclude_dirs    = $EXDIRS
obj_dir         = obj/
mod_dir         = mod/
cflags_heritage = True
colors          = True
jobs            = 8

[template-gnu]
template = template-base
compiler = gnu
cflags   = -c $STD_GNU

[template-nvf]
template = template-base
compiler = nvfortran
cflags   = -c

[template-intel]
template = template-base
compiler = intel_nextgen
cflags   = -c $STD_INT

[template-release]
build_profile = release

# ifx without the release profile: its -ipo writes IR objects that the link (FoBiS passes no -ipo to it) and a plain
# ar archive cannot read
[template-intel-release]
cflags = -c -O3 $STD_INT

[template-debug]
build_profile = debug

[template-lib-static]
target    = src/lib/elisha.F90
mklib     = static
output    = libelisha.a

[template-lib-shared]
target    = src/lib/elisha.F90
mklib     = shared
output    = libelisha.so

[template-tests]
src       = src/lib/ src/tests/
build_dir = exe/
ext_libs  = fftw3

[template-bench]
src       = src/lib/ src/tests/ src/bench/
build_dir = exe-bench/
target    = src/bench/elisha_bench_spectral_mpi.F90
output    = elisha_bench_spectral_mpi
ext_libs  = fftw3

# MPI: the compiler's wrapper (mpif90 of the Open MPI / HPC-X first on PATH); serial: the single-rank stub of the
# communication layer (ELISHA_NO_MPI), no MPI library at all
[template-mpi]
mpi = True

[template-serial]
preproc = -D_FFTW -DELISHA_NO_MPI

# ── rules ────────────────────────────────────────────────────────────────────
[rule-makecoverage]
help   = Build the tests with coverage instrumentation and run them
rule_1 = fobis clean --mode tests-gnu-coverage
rule_2 = fobis build --mode tests-gnu-coverage
rule_3 = bash scripts/run_tests.sh

[rule-makecoverage-analysis]
help   = Coverage analysis: the badge JSON in docs/public/coverage.json (what CI runs)
rule_1 = fobis rule --ex makecoverage
rule_2 = bash scripts/compute-coverage.sh

[rule-makedoc]
help   = Build the documentation: formal API + VitePress
rule_1 = cd docs && npm install --no-audit --no-fund && npm run docs:build

[rule-clean]
help = Remove build products and documentation artefacts
rule = rm -rf exe/ exe-bench/ lib/ obj/ mod/ docs/api/ docs/.vitepress/dist/ docs/.vitepress/cache/ docs/public/coverage.json
